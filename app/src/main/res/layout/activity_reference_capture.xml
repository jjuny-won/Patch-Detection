<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D1DEDD">

    <!-- 파란 곡선 헤더 -->
    <View
        android:id="@+id/headerBg"
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:background="@drawable/bg_header_blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reference"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="@id/headerBg"
        app:layout_constraintBottom_toBottomOf="@id/headerBg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Current Value 카드 -->
    <LinearLayout
        android:id="@+id/valueCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_white_card"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/headerBg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvSavedTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Current Value"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#3A5050"
            android:layout_marginBottom="8dp" />

        <!-- Gray -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Gray"
                android:textSize="15sp" android:textColor="#5A7070"/>
            <TextView android:id="@+id/tvGray" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0,0,0"
                android:textSize="15sp" android:textColor="#5A7070"/>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D0DEDE"/>

        <!-- Red -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Red"
                android:textSize="15sp" android:textColor="#5A7070"/>
            <TextView android:id="@+id/tvRed" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0,0,0"
                android:textSize="15sp" android:textColor="#5A7070"/>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D0DEDE"/>

        <!-- Green -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Green"
                android:textSize="15sp" android:textColor="#5A7070"/>
            <TextView android:id="@+id/tvGreen" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0,0,0"
                android:textSize="15sp" android:textColor="#5A7070"/>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D0DEDE"/>

        <!-- Blue -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Blue"
                android:textSize="15sp" android:textColor="#5A7070"/>
            <TextView android:id="@+id/tvBlue" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0,0,0"
                android:textSize="15sp" android:textColor="#5A7070"/>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D0DEDE"/>

        <!-- White -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="White"
                android:textSize="15sp" android:textColor="#5A7070"/>
            <TextView android:id="@+id/tvWhite" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0,0,0"
                android:textSize="15sp" android:textColor="#5A7070"/>
        </LinearLayout>

        <!-- 카드 내부 구분선 -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#D0DEDE" android:layout_marginTop="8dp"/>

        <!-- Reset | Add 버튼 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Reset"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#5A7070"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="16dp"
                app:elevation="2dp"
                app:rippleColor="#20000000" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnList"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Add"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#5A7070"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="16dp"
                app:elevation="2dp"
                app:rippleColor="#20000000" />
        </LinearLayout>

    </LinearLayout>

    <!-- 테스트 데이터 토글 -->
    <LinearLayout
        android:id="@+id/testDataRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/valueCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="테스트 데이터 사용"
            android:textSize="15sp"
            android:textColor="#5A7070" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchTestData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <!-- 하단 Monitor | Home 버튼 -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMonitor"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:text="Monitor"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#5A7070"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="16dp"
            app:elevation="2dp"
            app:rippleColor="#20000000" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Home"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#5A7070"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="16dp"
            app:elevation="2dp"
            app:rippleColor="#20000000" />

    </LinearLayout>

    <!-- 숨겨진 버튼 (기존 로직 유지용) -->
    <Button
        android:id="@+id/btnStart"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <Button
        android:id="@+id/btnSelectGallery"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
