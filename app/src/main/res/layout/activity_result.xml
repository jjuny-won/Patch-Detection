<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F4F8">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Result"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="#000"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- ORIGINAL TITLE -->
        <TextView
            android:id="@+id/originalTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Original Result"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000"
            app:layout_constraintTop_toBottomOf="@id/title"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- ORIGINAL CARD -->
        <LinearLayout
            android:id="@+id/resultCardOriginal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_result_card"
            android:orientation="vertical"
            android:padding="20dp"
            app:layout_constraintTop_toBottomOf="@id/originalTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Rectangular -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="@drawable/icon_rect"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rectangular"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#000"/>

                    <TextView
                        android:id="@+id/valueRect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(0, 0, 0)"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#000"/>
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#6E8FBA"/>

            <!-- Triangle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="@drawable/icon_triangle"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Triangle"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#000"/>

                    <TextView
                        android:id="@+id/valueTriangle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(0, 0, 0)"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#000"/>
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#6E8FBA"/>

            <!-- Circle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="@drawable/icon_circle"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Circle"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#000"/>

                    <TextView
                        android:id="@+id/valueCircle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(0, 0, 0)"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#000"/>
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#6E8FBA"/>

            <!-- Hexagon -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="@drawable/icon_polygon"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hexagon"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#000"/>

                    <TextView
                        android:id="@+id/valueHexagon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(0, 0, 0)"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#000"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- CORRECTED TITLE -->
        <TextView
            android:id="@+id/correctedTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Corrected Result"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000"
            app:layout_constraintTop_toBottomOf="@id/resultCardOriginal"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- CORRECTED CARD -->
        <LinearLayout
            android:id="@+id/resultCardCorrected"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_result_card"
            android:orientation="vertical"
            android:padding="20dp"
            app:layout_constraintTop_toBottomOf="@id/correctedTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Rectangular -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="@drawable/icon_rect"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rectangular"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#000"/>

                    <TextView
                        android:id="@+id/valueRectCorrected"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(0, 0, 0)"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#000"/>
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#6E8FBA"/>

            <!-- Triangle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="@drawable/icon_triangle"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Triangle"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#000"/>

                    <TextView
                        android:id="@+id/valueTriangleCorrected"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(0, 0, 0)"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#000"/>
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#6E8FBA"/>

            <!-- Circle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="@drawable/icon_circle"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Circle"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#000"/>

                    <TextView
                        android:id="@+id/valueCircleCorrected"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(0, 0, 0)"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#000"/>
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#6E8FBA"/>

            <!-- Hexagon -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="@drawable/icon_polygon"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hexagon"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#000"/>

                    <TextView
                        android:id="@+id/valueHexagonCorrected"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(0, 0, 0)"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#000"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- BUTTONS -->
        <LinearLayout
            android:id="@+id/buttonRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/resultCardCorrected"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <Button
                android:id="@+id/btnDebug"
                android:layout_width="140dp"
                android:layout_height="48dp"
                android:text="디버깅"
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="@drawable/bg_result_button"
                android:textColor="#000"/>

            <Space
                android:layout_width="30dp"
                android:layout_height="1dp"/>

            <Button
                android:id="@+id/btnMonitoring"
                android:layout_width="140dp"
                android:layout_height="48dp"
                android:text="모니터링"
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="@drawable/bg_result_button"
                android:textColor="#000"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>