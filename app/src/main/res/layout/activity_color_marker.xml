<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D1DEDD">


    <View
        android:id="@+id/headerBg"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:background="@drawable/bg_header_blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Patch 칩 (우측 정렬, 클릭 시 DebugActivity로 back) -->

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Wound Status"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/headerBg" />

    <TextView
        android:id="@+id/tvChip"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="Patch"
        android:textSize="14sp"
        android:textColor="#5A7070"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@drawable/bg_rounded_white_button"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/headerBg"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 스크롤 영역 -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="60dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/headerBg"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <!-- 색상 추출 영역 보기 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewRegions"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:text="샘플링 영역 보기"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#3A5050"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="14dp"
                app:elevation="2dp"
                app:strokeColor="#B7C6C6"
                app:strokeWidth="1dp"
                app:rippleColor="#20000000" />

            <!-- Reference Value 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_white_card"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reference Value"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#3A5050"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="10dp" android:paddingBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Gray" android:textSize="15sp" android:textColor="#5A7070"/>
                    <TextView android:id="@+id/tvRefGray" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0, 0, 0"
                        android:textSize="15sp" android:textColor="#5A7070"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D0DEDE"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="10dp" android:paddingBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Red" android:textSize="15sp" android:textColor="#5A7070"/>
                    <TextView android:id="@+id/tvRefRed" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0, 0, 0"
                        android:textSize="15sp" android:textColor="#5A7070"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D0DEDE"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="10dp" android:paddingBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Green" android:textSize="15sp" android:textColor="#5A7070"/>
                    <TextView android:id="@+id/tvRefGreen" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0, 0, 0"
                        android:textSize="15sp" android:textColor="#5A7070"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D0DEDE"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="10dp" android:paddingBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Blue" android:textSize="15sp" android:textColor="#5A7070"/>
                    <TextView android:id="@+id/tvRefBlue" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0, 0, 0"
                        android:textSize="15sp" android:textColor="#5A7070"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D0DEDE"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="White" android:textSize="15sp" android:textColor="#5A7070"/>
                    <TextView android:id="@+id/tvRefWhite" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0, 0, 0"
                        android:textSize="15sp" android:textColor="#5A7070"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Detected Value 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_white_card"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Detected Value"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#3A5050"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="10dp" android:paddingBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Gray" android:textSize="15sp" android:textColor="#5A7070"/>
                    <TextView android:id="@+id/tvDetGray" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0, 0, 0"
                        android:textSize="15sp" android:textColor="#5A7070"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D0DEDE"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="10dp" android:paddingBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Red" android:textSize="15sp" android:textColor="#5A7070"/>
                    <TextView android:id="@+id/tvDetRed" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0, 0, 0"
                        android:textSize="15sp" android:textColor="#5A7070"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D0DEDE"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="10dp" android:paddingBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Green" android:textSize="15sp" android:textColor="#5A7070"/>
                    <TextView android:id="@+id/tvDetGreen" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0, 0, 0"
                        android:textSize="15sp" android:textColor="#5A7070"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D0DEDE"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="10dp" android:paddingBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Blue" android:textSize="15sp" android:textColor="#5A7070"/>
                    <TextView android:id="@+id/tvDetBlue" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0, 0, 0"
                        android:textSize="15sp" android:textColor="#5A7070"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D0DEDE"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="White" android:textSize="15sp" android:textColor="#5A7070"/>
                    <TextView android:id="@+id/tvDetWhite" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0, 0, 0"
                        android:textSize="15sp" android:textColor="#5A7070"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 보정 결과 카드 -->
            <LinearLayout
                android:id="@+id/cardCalib"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_white_card"
                android:padding="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone">

                <!-- 헤더: 제목 + PASS/WARN/FAIL 배지 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="색상 보정 결과"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#3A5050"/>
                    <TextView
                        android:id="@+id/tvCalibGrade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:background="@drawable/bg_rounded_white_button"/>
                </LinearLayout>

                <!-- ΔE 보정 전 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="ΔE (보정 전)"
                        android:textSize="14sp" android:textColor="#7A9090"/>
                    <TextView android:id="@+id/tvDeltaEBefore"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--" android:textSize="14sp" android:textColor="#5A7070"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D0DEDE"/>

                <!-- ΔE 보정 후 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="ΔE (보정 후)"
                        android:textSize="14sp" android:textColor="#7A9090"/>
                    <TextView android:id="@+id/tvDeltaEAfter"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--" android:textSize="14sp" android:textColor="#5A7070"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D0DEDE"/>

                <!-- 개선율 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="개선율"
                        android:textSize="14sp" android:textColor="#7A9090"/>
                    <TextView android:id="@+id/tvImprovement"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--" android:textSize="14sp" android:textStyle="bold"
                        android:textColor="#44BB66"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D0DEDE"/>

                <!-- 노출 보정 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="노출 보정"
                        android:textSize="14sp" android:textColor="#7A9090"/>
                    <TextView android:id="@+id/tvExposureGain"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--" android:textSize="14sp" android:textColor="#5A7070"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 하단 버튼 -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMonitoring"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Monitor"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#5A7070"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="16dp"
            app:elevation="2dp"
            app:rippleColor="#20000000" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResult"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Result"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#5A7070"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="16dp"
            app:elevation="2dp"
            app:rippleColor="#20000000" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Home"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#5A7070"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="16dp"
            app:elevation="2dp"
            app:rippleColor="#20000000" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
