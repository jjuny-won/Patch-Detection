<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 전역 흰색 버튼 스타일 -->
    <style name="App.Button.White" parent="Widget.Material3.Button">
        <item name="backgroundTint">#FFFFFF</item>
        <item name="android:textColor">#5A7070</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">#20000000</item>
        <item name="android:elevation">2dp</item>
    </style>

    <!-- Base application theme. -->
    <style name="Base.Theme.Patch_Detection_Camera" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 모든 Button / MaterialButton 에 흰색 스타일 전역 적용 -->
        <item name="materialButtonStyle">@style/App.Button.White</item>
    </style>

    <style name="Theme.Patch_Detection_Camera" parent="Base.Theme.Patch_Detection_Camera" />
</resources>
